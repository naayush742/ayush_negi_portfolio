rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /contacts/{contactId} {
      allow read, write, create: if true;
    }
    match /contacts/{document=**} {
      allow read, write, create: if true;
    }
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 4);
    }
  }
}
